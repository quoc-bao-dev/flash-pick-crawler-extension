{
  "manifest_version": 3,
  "name": "Flash Pick - Crawler",
  "version": "1.0.0",
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://shopee.vn/*", "https://*.shopee.vn/*"],
      "js": ["content.js"]
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://shopee.vn/*",
    "https://*.shopee.vn/*",
    "https://localhost:3010/*",
    "http://localhost:3010/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["crawler.js", "assets/*.js"],
      "matches": ["https://shopee.vn/*", "https://*.shopee.vn/*"]
    }
  ]
}